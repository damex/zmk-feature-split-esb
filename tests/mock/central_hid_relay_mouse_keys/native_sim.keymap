#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK       &mkp RCLK
                &mmv MOVE_RIGHT &msc SCRL_UP
            >;
        };
    };
};

&mkp_input_listener {
    input-processors = <&esb_relay_pointer>;
};

&mmv_input_listener {
    input-processors = <&esb_relay_pointer>;
};

&msc_input_listener {
    input-processors = <&esb_relay_pointer>;
};

&kscan {
    /delete-property/ exit-after;
    events = <
        ZMK_MOCK_PRESS(0,0,50)
        ZMK_MOCK_PRESS(0,1,50)
        ZMK_MOCK_RELEASE(0,0,50)
        ZMK_MOCK_RELEASE(0,1,50)
        ZMK_MOCK_PRESS(0,0,0)
        ZMK_MOCK_RELEASE(0,0,50)
        ZMK_MOCK_PRESS(1,0,100)
        ZMK_MOCK_RELEASE(1,0,50)
        ZMK_MOCK_PRESS(1,1,300)
        ZMK_MOCK_RELEASE(1,1,10)
    >;
};
