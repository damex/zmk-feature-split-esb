#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A &kp B
                &kp C &none
            >;
        };
    };
};

&kscan {
    /delete-property/ exit-after;
    /* Mock reuses each delay as the gap after its event.
     * The &none tap sets where the burst starts. */
    events = <
        ZMK_MOCK_PRESS(1,1,100)
        ZMK_MOCK_RELEASE(1,1,100)
        ZMK_MOCK_PRESS(0,0,1)
        ZMK_MOCK_PRESS(0,1,1)
        ZMK_MOCK_PRESS(1,0,1)
        ZMK_MOCK_RELEASE(0,0,1)
        ZMK_MOCK_RELEASE(0,1,1)
        ZMK_MOCK_RELEASE(1,0,10)
    >;
};
