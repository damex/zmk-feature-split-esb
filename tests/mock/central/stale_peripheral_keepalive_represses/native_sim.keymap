#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A &kp B
                &kp C &kp D
            >;
        };
    };
};

&kscan {
    /delete-property/ exit-after;
    events = <
        ZMK_MOCK_PRESS(1,1,5000)
        ZMK_MOCK_RELEASE(1,1,10)
    >;
};
